# Copy to .env and fill in the keys you have. Every fetcher degrades gracefully
# (reports "not_configured" via /api/health) if its key is missing, so you can
# run this with zero keys set and only /api/fires-like features will be idle.

# NASA FIRMS — free MAP_KEY, register at https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# OpenAQ v3 — free API key, register at https://explore.openaq.org (Account > API Keys)
OPENAQ_API_KEY=

# Global Forest Watch Data API — sign up and generate an API key at
# https://www.globalforestwatch.org/my-gfw/ (Developer / API keys section)
GFW_API_KEY=

# Server port
PORT=8080

# How often to re-poll upstream sources, in cron syntax (default: every 30 minutes)
POLL_CRON=*/30 * * * *
